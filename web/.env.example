# Copy this file to .env.local and fill in real values — never commit .env.local
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ห้าม commit .env.local ขึ้น git

# Shared password admin staff use to log into /admin. Pick a real one — not this placeholder.
# รหัสผ่านที่ทีม admin ใช้ล็อกอิน /admin — ตั้งค่าจริง อย่าใช้ค่านี้
ADMIN_PASSWORD=change-me

# Any long random string — signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ค่าสุ่มยาวๆ ไว้เซ็นรับรอง session cookie ของ admin — สร้างด้วยคำสั่งด้านบน
ADMIN_SESSION_SECRET=change-me

# Postgres connection string (Vercel Storage → Neon integration fills this in automatically
# after `vercel env pull .env.local`). Needed once Manage Products / Reports move off static JSON.
# connection string ของ Postgres — Vercel จะกรอกให้อัตโนมัติหลัง connect DB แล้วรัน `vercel env pull .env.local`
DATABASE_URL=

# Vercel Blob read-write token (Vercel Storage → Blob store). Used for uploading the SKU
# package-photo images (front/back/barcode/etc.) that admins add on the product edit page.
# token เขียน/อ่าน Vercel Blob — ใช้ตอนอัปโหลดรูปแพ็กเกจของแต่ละ SKU
BLOB_READ_WRITE_TOKEN=

# remove.bg API key (https://www.remove.bg/api — sign up, get key from account dashboard).
# Used for the "ลบพื้นหลังออโต้" option on photo upload. Paid per image past the free tier —
# without this set, choosing "auto" on upload shows an error telling the admin to pick "ไม่ลบ".
# API key ของ remove.bg — ใช้ตอนเลือก "ลบพื้นหลังออโต้" ตอนอัปโหลดรูป มีค่าใช้จ่ายต่อรูปเกิน free tier
REMOVEBG_API_KEY=
